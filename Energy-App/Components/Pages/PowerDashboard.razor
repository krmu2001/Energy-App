@page "/"
@using Energy_App.Features.PowerPrices.Analytics
@using Energy_App.Features.PowerPrices.Models
@using Energy_App.Features.PowerPrices.Services

@inject IEnergyChartService EnergyChartService
@inject PowerPriceAnalytics PowerPriceAnalytics

@rendermode InteractiveServer

<MudThemeProvider />
<MudPopoverProvider />

<h1>Energy Dashboard</h1>

<!-- Filters -->
<MudPaper Class="pa-6 mb-6"
          Elevation="1"
          Outlined="true">
    <MudGrid AlignItems="AlignItems.Center">
        <!-- Bidding Zone -->
        <MudItem xs="12" 
                 sm="6" 
                 md="3">
            <MudSelect T="string"
                       Label="Bidding Zone"
                       @bind-Value="_biddingZone">

                <MudSelectItem Value="@("DK1")">DK1</MudSelectItem>
                <MudSelectItem Value="@("DK2")">DK2</MudSelectItem>

            </MudSelect>
        </MudItem>
        
        <!-- Start Date -->
        <MudItem xs="12" 
                 sm="6" 
                 md="3">
            <MudDatePicker Label="Start Date"
                           @bind-Date="_selectedStartDate" />
        </MudItem>
        
        <!-- End Date -->
        <MudItem xs="12" 
                 sm="6" 
                 md="3">
            <MudDatePicker Label="End Date"
                           @bind-Date="_selectedEndDate" />
        </MudItem>
        
        <!-- Load Prices -->
        <MudItem xs="12" 
                 sm="6" 
                 md="3">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="LoadPricesAsync">
                Load prices
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_isLoading)
{
    <p>Loading electricity prices...</p>
}
else if (_errorMessage is not null)
{
    <p>@_errorMessage</p>
}
else if (_electricityPrice is null)
{
    <p>Select your criteria and load electricity prices.</p>
}
else
{
    <!-- Analytics -->
    <MudGrid>
        <MudItem xs="12" 
                 sm="6" 
                 md="4">
            <MudPaper Class="pa-5"
                      Elevation="1"
                      Outlined="true">
                <MudText Typo="Typo.overline">
                    Average Price
                </MudText>

                <MudText Typo="Typo.h4" Class="mt-1">
                    @_averagePrice.ToString("F2")
                </MudText>

                <MudText Typo="Typo.body2">
                    @_electricityPrice.Unit
                </MudText>
            </MudPaper>
        </MudItem>

        @if (_minimumPricePoint is not null)
        {
            <MudItem xs="12" 
                     sm="6" 
                     md="4">
                <MudPaper Class="pa-5"
                          Elevation="1"
                          Outlined="true">
                    <MudText Typo="Typo.overline">
                        Minimum Price
                    </MudText>

                    <MudText Typo="Typo.h4" Class="mt-1">
                        @_minimumPricePoint.Values["day_ahead_price"].ToString("F2")
                    </MudText>

                    <MudText Typo="Typo.body2">
                        @_electricityPrice.Unit
                    </MudText>

                    <MudText Typo="Typo.body2">
                        at @_minimumPricePoint.Timestamp.ToString("dd/MM/yyyy HH:mm")
                    </MudText>
                </MudPaper>
            </MudItem>
        }

        @if (_maximumPricePoint is not null)
        {
            <MudItem xs="12" 
                     sm="6" 
                     md="4">
                <MudPaper Class="pa-5"
                          Elevation="1"
                          Outlined="true">
                    <MudText Typo="Typo.overline">
                        Maximum Price
                    </MudText>

                    <MudText Typo="Typo.h4" Class="mt-1">
                        @_maximumPricePoint.Values["day_ahead_price"].ToString("F2")
                    </MudText>

                    <MudText Typo="Typo.body2">
                        @_electricityPrice.Unit
                    </MudText>

                    <MudText Typo="Typo.body2">
                        at @_maximumPricePoint.Timestamp.ToString("dd/MM/yyyy HH:mm")
                    </MudText>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>

    <!-- Chart -->
    <MudPaper Class="pa-4 mt-4" Elevation="1">
        <MudText Typo="Typo.h6">
            Price
        </MudText>

        <MudChart T="decimal"
                  ChartType="ChartType.Line"
                  ChartSeries="@_series"
                  ChartLabels="@_xAxisLabels"
                  ChartOptions="@_options" />
    </MudPaper>

    <!-- Metadata -->
    <MudPaper Class="pa-4 mt-4" Elevation="0">
        <MudText Typo="Typo.subtitle2">
            Market Data
        </MudText>

        <MudText Typo="Typo.body2">
            Bidding zone: @_electricityPrice.BiddingZone
        </MudText>

        <MudText Typo="Typo.body2">
            Unit: @_electricityPrice.Unit
        </MudText>

        <MudText Typo="Typo.body2">
            Resolution: @_electricityPrice.Resolution
        </MudText>

        <MudText Typo="Typo.body2">
            Interval: @_electricityPrice.IntervalMinutes minutes
        </MudText>

        <MudText Typo="Typo.body2">
            Data points: @_electricityPrice.Data.Count
        </MudText>
    </MudPaper>

    <h2>First prices</h2>

    @foreach (var pricePoint in _electricityPrice.Data.Take(5))
    {
        <p>
            @pricePoint.Timestamp:
            @pricePoint.Values["day_ahead_price"] @_electricityPrice.Unit
        </p>
    }
}

@code {
    private PowerPriceResponse? _electricityPrice;
    
    private bool _isLoading;
    private string? _errorMessage = null;
    private decimal _averagePrice;
    private PowerPricePoint? _minimumPricePoint;
    private PowerPricePoint? _maximumPricePoint;
    
    private string _biddingZone = "DK1";
    private DateTime? _selectedStartDate = new(2026, 09, 11);
    private DateTime? _selectedEndDate = new(2026, 09, 12);

    private List<ChartSeries<decimal>> _series = new();
    
    private LineChartOptions _options = new()
    {
        XAxisTitle = "Time",
        YAxisTitle = "Price (EUR/MWh)",
    };
    
    private string[] _xAxisLabels = {  };

    private void UpdateChart()
    {
        if (_electricityPrice is null)
            return;

        _xAxisLabels = _electricityPrice.Data
            .Select(x =>
            {
                if (x.Timestamp.Minute != 0)
                    return string.Empty;

                if (x.Timestamp.Hour == 0)
                    return x.Timestamp.ToString("dd/MM");

                return x.Timestamp.Hour % 4 == 0
                    ? x.Timestamp.ToString("HH:mm")
                    : string.Empty;
            })
            .ToArray();
        
        var prices = _electricityPrice.Data
            .Select(x => x.Values["day_ahead_price"])
            .ToArray();

        _series =
        [
            new ChartSeries<decimal>
            {
                Name = "Prices",
                Data = prices,
            }
        ];
    }

    private async Task LoadPricesAsync()
    {
        _errorMessage = null;

        if (_selectedStartDate is null || _selectedEndDate is null)
        {
            _errorMessage = "Please select both a start date and an end date.";
            return;
        }

        if (_selectedStartDate > _selectedEndDate)
        {
            _errorMessage = "Start date cannot be after end date.";
            return;
        }

        _isLoading = true;

        try
        {
            var startDate = DateOnly.FromDateTime(_selectedStartDate.Value);
            var endDate = DateOnly.FromDateTime(_selectedEndDate.Value);

            _electricityPrice = await EnergyChartService.GetPricesAsync(
                _biddingZone,
                startDate,
                endDate);

            if (_electricityPrice != null)
            {
                _averagePrice = PowerPriceAnalytics.CalculateAveragePrice(_electricityPrice);
                _minimumPricePoint = PowerPriceAnalytics.FindMinimumPricePoint(_electricityPrice);
                _maximumPricePoint = PowerPriceAnalytics.FindMaximumPricePoint(_electricityPrice);
            }

            UpdateChart();
        }
        catch (HttpRequestException)
        {
            _errorMessage = "Unable to load electricity prices. Please try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }
}