@page "/"
@using Energy_App.Features.PowerPrices.Analytics
@using Energy_App.Features.PowerPrices.Models
@using Energy_App.Features.PowerPrices.Services
@using MudBlazor.Charts

@inject IEnergyChartService EnergyChartService
@inject PowerPriceAnalytics PowerPriceAnalytics

@rendermode InteractiveServer

<MudThemeProvider />
<MudPopoverProvider />

<h1>Energy Dashboard</h1>

<!-- Filters -->
<MudPaper Class="pa-6 mb-6"
          Elevation="1"
          Outlined="true">
    <MudGrid AlignItems="AlignItems.Center">
        <!-- Bidding Zone -->
        <MudItem xs="12" 
                 sm="6" 
                 md="3">
            <MudSelect T="string"
                       Label="Bidding Zone"
                       @bind-Value="_biddingZone">

                <MudSelectItem Value="@("DK1")">DK1</MudSelectItem>
                <MudSelectItem Value="@("DK2")">DK2</MudSelectItem>

            </MudSelect>
        </MudItem>
        
        <!-- Start Date -->
        <MudItem xs="12" 
                 sm="6" 
                 md="3">
            <MudDatePicker Label="Start Date"
                           @bind-Date="_selectedStartDate" />
        </MudItem>
        
        <!-- End Date -->
        <MudItem xs="12" 
                 sm="6" 
                 md="3">
            <MudDatePicker Label="End Date"
                           @bind-Date="_selectedEndDate" />
        </MudItem>
        
        <!-- Load Prices -->
        <MudItem xs="12" 
                 sm="6" 
                 md="3">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="LoadPricesAsync">
                Load prices
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_isLoading)
{
    <p>Loading electricity prices...</p>
}
else if (_errorMessage is not null)
{
    <p>@_errorMessage</p>
}
else if (_electricityPrice is null)
{
    <p>Select your criteria and load electricity prices.</p>
}
else
{
    <!-- Analytics -->
    <MudGrid>
        <MudItem xs="12" 
                 sm="6" 
                 md="3">
            <MudPaper Class="pa-5"
                      Elevation="1"
                      Outlined="true">
                <MudText Typo="Typo.overline">
                    Average Price
                </MudText>

                <MudText Typo="Typo.h4" Class="mt-1">
                    @_averagePrice.ToString("F2")
                </MudText>

                <MudText Typo="Typo.body2">
                    @_electricityPrice.Unit
                </MudText>
            </MudPaper>
        </MudItem>

        @if (_minimumPricePoint is not null)
        {
            <MudItem xs="12" 
                     sm="6" 
                     md="3">
                <MudPaper Class="pa-5"
                          Elevation="1"
                          Outlined="true">
                    <MudText Typo="Typo.overline">
                        Minimum Price
                    </MudText>

                    <MudText Typo="Typo.h4" Class="mt-1">
                        @_minimumPricePoint.Values["day_ahead_price"].ToString("F2")
                    </MudText>

                    <MudText Typo="Typo.body2">
                        @_electricityPrice.Unit
                    </MudText>

                    <MudText Typo="Typo.body2">
                        at @_minimumPricePoint.Timestamp.ToString("dd/MM/yyyy HH:mm")
                    </MudText>
                </MudPaper>
            </MudItem>
        }

        @if (_maximumPricePoint is not null)
        {
            <MudItem xs="12" 
                     sm="6" 
                     md="3">
                <MudPaper Class="pa-5"
                          Elevation="1"
                          Outlined="true">
                    <MudText Typo="Typo.overline">
                        Maximum Price
                    </MudText>

                    <MudText Typo="Typo.h4" Class="mt-1">
                        @_maximumPricePoint.Values["day_ahead_price"].ToString("F2")
                    </MudText>

                    <MudText Typo="Typo.body2">
                        @_electricityPrice.Unit
                    </MudText>

                    <MudText Typo="Typo.body2">
                        at @_maximumPricePoint.Timestamp.ToString("dd/MM/yyyy HH:mm")
                    </MudText>
                </MudPaper>
            </MudItem>
        }
        
        @if (_negativePricePoints.Count > 0)
        {
            <MudItem xs="12"
                     sm="6"
                     md="3">
                <MudPaper Class="pa-5"
                          Elevation="1"
                          Outlined="true">
                    <MudText Typo="Typo.overline">
                        Negative Price Points
                    </MudText>

                    <MudText Typo="Typo.h4" Class="mt-1">
                        @_negativePricePoints.Count
                    </MudText>

                    <MudText Typo="Typo.body2">
                        intervals below 0 @_electricityPrice.Unit
                    </MudText>
                    
                    <MudText Typo="Typo.body2">
                        @($"{(int)_negativePriceDuration.TotalHours}h {_negativePriceDuration.Minutes}m total")
                    </MudText>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
    
    @if (_cheapestPeriod is not null)
    {
        <MudPaper Class="pa-5 mt-4"
                  Elevation="1"
                  Outlined="true">

            <MudText Typo="Typo.overline">
                Cheapest @_selectedDurationHours-Hour Period
            </MudText>

            <MudText Typo="Typo.h5" Class="mt-1">
                @_cheapestPeriod.StartDate.ToString("dd/MM/yyyy HH:mm")
                –
                @_cheapestPeriod.EndDate.ToString("HH:mm")
            </MudText>

            <MudText Typo="Typo.body2">
                Average price:
                @_cheapestPeriod.AveragePrice.ToString("F2")
                @_electricityPrice.Unit
            </MudText>
            
            <MudSelect T="int"
                       Label="Duration"
                       @bind-Value="_selectedDurationHours"
                       @bind-Value:after="UpdateCheapestPeriod">
                <MudSelectItem Value="1">1 hour</MudSelectItem>
                <MudSelectItem Value="2">2 hours</MudSelectItem>
                <MudSelectItem Value="3">3 hours</MudSelectItem>
                <MudSelectItem Value="4">4 hours</MudSelectItem>
            </MudSelect>

        </MudPaper>
    }

    <!-- Chart -->
    <MudPaper Class="pa-4 mt-4" Elevation="1">
        <MudText Typo="Typo.h6">
            Price
        </MudText>

        <MudChart T="decimal"
                  ChartType="ChartType.Timeseries"
                  ChartSeries="@_series"
                  ChartOptions="@_options" />
    </MudPaper>

    <!-- Metadata -->
    <MudPaper Class="pa-4 mt-4" Elevation="0">
        <MudText Typo="Typo.subtitle2">
            Market Data
        </MudText>

        <MudText Typo="Typo.body2">
            Bidding zone: @_electricityPrice.BiddingZone
        </MudText>

        <MudText Typo="Typo.body2">
            Unit: @_electricityPrice.Unit
        </MudText>

        <MudText Typo="Typo.body2">
            Resolution: @_electricityPrice.Resolution
        </MudText>

        <MudText Typo="Typo.body2">
            Interval: @_electricityPrice.IntervalMinutes minutes
        </MudText>

        <MudText Typo="Typo.body2">
            Data points: @_electricityPrice.Data.Count
        </MudText>
    </MudPaper>

    <h2>First prices</h2>

    @foreach (var pricePoint in _electricityPrice.Data.Take(5))
    {
        <p>
            @pricePoint.Timestamp:
            @pricePoint.Values["day_ahead_price"] @_electricityPrice.Unit
        </p>
    }
}

@code {
    private PowerPriceResponse? _electricityPrice;
    
    private bool _isLoading;
    private string? _errorMessage = null;
    private decimal _averagePrice;
    private PowerPricePoint? _minimumPricePoint;
    private PowerPricePoint? _maximumPricePoint;
    private List<PowerPricePoint> _negativePricePoints = new();
    private TimeSpan _negativePriceDuration;
    private int _selectedDurationHours = 2;
    private CheapestPeriodResult? _cheapestPeriod;
    
    private string _biddingZone = "DK1";
    private DateTime? _selectedStartDate = new(2026, 09, 11);
    private DateTime? _selectedEndDate = new(2026, 09, 12);

    private List<ChartSeries<decimal>> _series = new();
    
    private TimeSeriesChartOptions _options = new()
    {
        XAxisTitle = "Time",
        YAxisTitle = "Price (EUR/MWh)",
        TooltipTimeLabelFormat = "dd/MM/yyyy HH:mm",
        ShowDataMarkers = false
    };
    
    private void UpdateChart()
    {
        if (_electricityPrice is null || _electricityPrice.Data.Count == 0)
            return;

        var prices = _electricityPrice.Data
            .Select(x => new TimeValue<decimal>(
                x.Timestamp.DateTime,
                x.Values["day_ahead_price"]))
            .ToArray();

        var start = _electricityPrice.Data.First().Timestamp;
        var end = _electricityPrice.Data.Last().Timestamp;
        var duration = end - start;

        var isSingleDay = duration <= TimeSpan.FromDays(1);

        _options.TimeLabelFormat = isSingleDay
            ? "HH:mm"
            : "dd/MM";

        _options.TimeLabelSpacing = isSingleDay
            ? TimeSpan.FromHours(4)
            : TimeSpan.FromDays(1);

        _series =
        [
            new ChartSeries<decimal>
            {
                Name = "Power Price",
                Data = prices
            }
        ];
    }
    
    private void UpdateCheapestPeriod()
    {
        if (_electricityPrice is null)
            return;

        _cheapestPeriod = PowerPriceAnalytics.FindCheapestPeriod(
            _electricityPrice,
            _selectedDurationHours);
    }

    private async Task LoadPricesAsync()
    {
        _errorMessage = null;

        if (_selectedStartDate is null || _selectedEndDate is null)
        {
            _errorMessage = "Please select both a start date and an end date.";
            return;
        }

        if (_selectedStartDate > _selectedEndDate)
        {
            _errorMessage = "Start date cannot be after end date.";
            return;
        }

        _isLoading = true;

        try
        {
            var startDate = DateOnly.FromDateTime(_selectedStartDate.Value);
            var endDate = DateOnly.FromDateTime(_selectedEndDate.Value);

            _electricityPrice = await EnergyChartService.GetPricesAsync(
                _biddingZone,
                startDate,
                endDate);

            if (_electricityPrice != null)
            {
                _averagePrice = PowerPriceAnalytics.CalculateAveragePrice(_electricityPrice);
                _minimumPricePoint = PowerPriceAnalytics.FindMinimumPricePoint(_electricityPrice);
                _maximumPricePoint = PowerPriceAnalytics.FindMaximumPricePoint(_electricityPrice);
                _negativePricePoints = PowerPriceAnalytics.FindNegativePricePoints(_electricityPrice);
                _negativePriceDuration = PowerPriceAnalytics.CalculateNegativePriceDuration(_electricityPrice);
                
                UpdateCheapestPeriod();
            }

            UpdateChart();
        }
        catch (HttpRequestException)
        {
            _errorMessage = "Unable to load electricity prices. Please try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }
}